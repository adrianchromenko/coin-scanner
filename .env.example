# Copy this file to .env.local and paste your key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Firebase (accounts + "My coins"). Optional: leave blank and the app runs without accounts.
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Scan access & limits (server) ----
# "1" = visitors must sign in (Firebase) before scanning. Default: anyone can scan.
REQUIRE_SIGN_IN=0
# Scans allowed per user (or per IP when signed out) per UTC day. 0 or blank = unlimited.
DAILY_SCAN_LIMIT=25
# Comma-separated emails allowed to open the /admin usage dashboard.
ADMIN_EMAILS=
# Optional Firebase service-account JSON (or base64 of it) so the server can verify
# sign-in tokens and keep usage counters in Firestore. Without it, tokens are verified
# through Google's REST endpoint and counters live in server memory.
FIREBASE_SERVICE_ACCOUNT=
# "0" turns off the live sold-price web search during identification.
PRICE_SEARCH=1

# ---- eBay one-tap listing (optional; the button is hidden until these are set) ----
# developer.ebay.com -> Application Keys. Start with the Sandbox keyset.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName from "User Tokens -> Get a Token from eBay via Your Application".
# Its "auth accepted URL" must be  <your site>/api/ebay/callback
EBAY_RU_NAME=
# sandbox | production
EBAY_ENV=sandbox
# 32+ random characters; encrypts the seller refresh-token cookie (openssl rand -hex 32).
EBAY_TOKEN_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# Used once to create the merchant location eBay requires.
EBAY_POSTAL_CODE=
