rules_version = '2';

// Each signed-in user can read and write only their own collection:
//   users/{uid}/coins/{coinId}             listing + thumbnail
//   users/{uid}/coins/{coinId}/images/full the two full photos
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
